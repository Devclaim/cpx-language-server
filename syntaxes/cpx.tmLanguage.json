{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CPX",
  "scopeName": "source.cpx",
  "fileTypes": [
    "cpx"
  ],
  "injections": {},
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#import-statement"
    },
    {
      "include": "#component-declaration"
    },
    {
      "include": "#struct-declaration"
    },
    {
      "include": "#enum-declaration"
    },
    {
      "include": "#render-block"
    },
    {
      "include": "#property-declaration"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cpx",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.cpx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "component-declaration": {
      "name": "meta.component.cpx",
      "begin": "^(\\s*)(export)\\s+(component)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.export.js"
        },
        "3": {
          "name": "storage.type.class.js"
        },
        "4": {
          "name": "entity.name.type.class.js"
        },
        "5": {
          "name": "punctuation.section.block.begin.cpx"
        }
      },
      "end": "^(\\s*)(\\})\\s*$",
      "endCaptures": {
        "2": {
          "name": "punctuation.section.block.end.cpx"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#render-block"
        },
        {
          "include": "#property-declaration"
        },
        {
          "include": "#keywords"
        }
      ]
    },
    "struct-declaration": {
      "name": "meta.struct.cpx",
      "begin": "^(\\s*)(export)\\s+(struct)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.export.js"
        },
        "3": {
          "name": "storage.type.class.js"
        },
        "4": {
          "name": "entity.name.type.class.js"
        },
        "5": {
          "name": "punctuation.section.block.begin.cpx"
        }
      },
      "end": "^(\\s*)(\\})\\s*$",
      "endCaptures": {
        "2": {
          "name": "punctuation.section.block.end.cpx"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#property-declaration"
        },
        {
          "include": "#keywords"
        }
      ]
    },
    "enum-declaration": {
      "name": "meta.enum.cpx",
      "begin": "^(\\s*)(export)\\s+(enum)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.export.js"
        },
        "3": {
          "name": "storage.type.enum.js"
        },
        "4": {
          "name": "entity.name.type.class.js"
        },
        "5": {
          "name": "punctuation.section.block.begin.cpx"
        }
      },
      "end": "^(\\s*)(\\})\\s*$",
      "endCaptures": {
        "2": {
          "name": "punctuation.section.block.end.cpx"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#enum-member"
        },
        {
          "include": "#expression"
        },
        {
          "include": "#keywords"
        }
      ]
    },
    "enum-member": {
      "name": "meta.enum-member.cpx",
      "begin": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\(|,|$)",
      "beginCaptures": {
        "2": {
          "name": "variable.other.enummember.js"
        }
      },
      "end": "$",
      "patterns": [
        {
          "name": "punctuation.definition.group.begin.js",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.group.end.js",
          "match": "\\)"
        },
        {
          "include": "#string-literal"
        },
        {
          "include": "#integer-literal"
        },
        {
          "name": "punctuation.separator.comma.js",
          "match": ","
        }
      ]
    },
    "import-statement": {
      "name": "meta.import.cpx",
      "begin": "^(\\s*)(from)\\b",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.import.js"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#string-literal"
        },
        {
          "name": "keyword.control.import.js",
          "match": "\\b(import|from|as)\\b"
        },
        {
          "name": "variable.other.readwrite.js",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.name.type.class.js",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.definition.bracket.curly.begin.js",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.bracket.curly.end.js",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.comma.js",
          "match": ","
        }
      ]
    },
    "string-literal": {
      "name": "string.quoted.double.cpx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cpx",
          "match": "\\\\[\"&{}\\\\/bfnrt]"
        },
        {
          "name": "constant.character.escape.unicode.cpx",
          "match": "\\\\u[0-9a-fA-F]+"
        },
        {
          "include": "#xml-character-reference"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string-constant": {
      "name": "string.quoted.double.cpx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cpx",
          "match": "\\\\[\"&{}\\\\/bfnrt]"
        },
        {
          "name": "constant.character.escape.unicode.cpx",
          "match": "\\\\u[0-9a-fA-F]+"
        },
        {
          "include": "#xml-character-reference"
        }
      ]
    },
    "xml-character-reference": {
      "name": "constant.character.entity.html",
      "match": "&(?:[a-zA-Z]+|#(?:x[0-9a-fA-F]+|[0-9]+));"
    },
    "integer-literal": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cpx",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.cpx",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.cpx",
          "match": "\\b0o[0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.cpx",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "cpx-attribute-value": {
      "patterns": [
        {
          "include": "#string-literal"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "cpx-markup": {
      "patterns": [
        {
          "include": "#cpx-tags"
        },
        {
          "name": "text.html.basic",
          "match": "[^<>{}&]+"
        }
      ]
    },
    "tag-body": {
      "comment": "Content between > and </ — activates text highlighting for tag children",
      "begin": ">",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(?=</)",
      "patterns": [
        {
          "include": "#cpx-markup"
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "comment": "Attribute with value: name=...",
          "begin": "([a-zA-Z_:][a-zA-Z0-9:._-]*)\\s*(=)",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            }
          },
          "end": "(?=[\\s/?>])",
          "patterns": [
            {
              "include": "#cpx-attribute-value"
            }
          ]
        },
        {
          "comment": "Boolean attribute (no value)",
          "name": "entity.other.attribute-name.html",
          "match": "[a-zA-Z_:][a-zA-Z0-9:._-]*"
        }
      ]
    },
    "match-expression": {
      "comment": "match (subject) { arm -> expr, ... }",
      "name": "meta.match.cpx",
      "begin": "\\b(match)\\b([^{]*)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.cpx"
        },
        "3": {
          "name": "punctuation.definition.block.begin.js"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.js"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "comment": "default keyword in match arm",
          "name": "keyword.control.cpx",
          "match": "\\bdefault\\b"
        },
        {
          "comment": "match arm arrow",
          "name": "keyword.operator.arrow.cpx",
          "match": "->"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#cpx-tags"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.cpx",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.cpx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.cpx"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#match-expression"
        },
        {
          "include": "#cpx-tags"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#match-expression"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#string-literal"
        },
        {
          "include": "#integer-literal"
        },
        {
          "name": "constant.language.boolean.js",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.js",
          "match": "\\bnull\\b"
        },
        {
          "name": "keyword.control.cpx",
          "match": "\\b(match|default)\\b"
        },
        {
          "name": "keyword.operator.null-coalescing.cpx",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.optional-access.cpx",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.ternary.js",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.unary.cpx",
          "match": "!"
        },
        {
          "name": "keyword.operator.arrow.cpx",
          "match": "->"
        },
        {
          "name": "keyword.operator.logical.js",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.type.cpx",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.comparison.js",
          "match": "===|!==|>=|<="
        },
        {
          "name": "keyword.operator.assignment.js",
          "match": "="
        },
        {
          "name": "keyword.operator.accessor.js",
          "match": "\\."
        },
        {
          "name": "keyword.operator.arithmetic.js",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "punctuation.separator.comma.js",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.js",
          "match": ";"
        },
        {
          "name": "punctuation.definition.array.begin.js",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.array.end.js",
          "match": "\\]"
        },
        {
          "name": "punctuation.definition.group.begin.js",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.group.end.js",
          "match": "\\)"
        },
        {
          "name": "punctuation.definition.block.begin.js",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.block.end.js",
          "match": "\\}"
        },
        {
          "comment": "Built-in type names",
          "name": "support.type.primitive.cpx",
          "match": "\\??\\b(boolean|string|number|slot)\\b"
        },
        {
          "comment": "PascalCase identifiers = types/enum variants",
          "name": "entity.name.type.class.js",
          "match": "\\??[A-Z][A-Za-z0-9_]*(?:\\[\\])?"
        },
        {
          "comment": "camelCase identifiers = variables/properties",
          "name": "variable.other.property.js",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.js",
          "match": "\\b(import|from|as)\\b"
        },
        {
          "name": "keyword.control.export.js",
          "match": "\\bexport\\b"
        },
        {
          "name": "storage.type.class.js",
          "match": "\\b(component|struct)\\b"
        },
        {
          "name": "storage.type.enum.js",
          "match": "\\benum\\b"
        },
        {
          "name": "keyword.control.cpx",
          "match": "\\b(render|match|default)\\b"
        },
        {
          "name": "constant.language.null.js",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.boolean.js",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "property-declaration": {
      "name": "meta.property.cpx",
      "begin": "^(\\s*)([a-z_][A-Za-z0-9_]*)(\\s*:\\s*)",
      "beginCaptures": {
        "2": {
          "name": "variable.other.property.js"
        },
        "3": {
          "name": "punctuation.separator.key-value.cpx"
        }
      },
      "end": "$",
      "patterns": [
        {
          "comment": "Built-in types",
          "name": "support.type.primitive.cpx",
          "match": "\\b(boolean|string|number|slot)(?:\\[\\])?"
        },
        {
          "comment": "Optional type prefix",
          "name": "keyword.operator.optional.cpx",
          "match": "\\?"
        },
        {
          "comment": "PascalCase type with optional [] suffix",
          "name": "entity.name.type.class.js",
          "match": "[A-Z][A-Za-z0-9_]*(?:\\[\\])?"
        },
        {
          "name": "keyword.operator.type.cpx",
          "match": "\\|"
        }
      ]
    },
    "render-block": {
      "name": "meta.render.cpx",
      "begin": "^(\\s*)(render)\\b",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.cpx"
        }
      },
      "end": "(?=^(\\s*)\\})",
      "contentName": "meta.markup.cpx",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#match-expression"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#cpx-markup"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "cpx-tags": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#interpolation"
        },
        {
          "comment": "Fragment close </> ",
          "name": "meta.tag.block.any.html",
          "match": "(</)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "punctuation.definition.tag.end.html"
            }
          }
        },
        {
          "comment": "Fragment open <>",
          "name": "meta.tag.block.any.html",
          "match": "(<)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "punctuation.definition.tag.end.html"
            }
          }
        },
        {
          "comment": "Component element <MyComponent ...>children</MyComponent> or self-closing",
          "name": "meta.tag.block.any.html",
          "begin": "(<)([A-Z][A-Za-z0-9_]*)(?=[\\s/>])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.type.class.js"
            }
          },
          "end": "(/>)|(</)([A-Z][A-Za-z0-9_]*)(\\s*>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            },
            "2": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "3": {
              "name": "entity.name.type.class.js"
            },
            "4": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#tag-attributes"
            },
            {
              "include": "#tag-body"
            }
          ]
        },
        {
          "comment": "HTML element <div ...>children</div> or self-closing",
          "name": "meta.tag.block.any.html",
          "begin": "(<)([a-z][A-Za-z0-9:._-]*)(?=[\\s/>])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.html"
            }
          },
          "end": "(/>)|(</)([a-z][A-Za-z0-9:._-]*)(\\s*>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            },
            "2": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "3": {
              "name": "entity.name.tag.html"
            },
            "4": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#tag-attributes"
            },
            {
              "include": "#tag-body"
            }
          ]
        },
        {
          "include": "#xml-character-reference"
        }
      ]
    }
  }
}
